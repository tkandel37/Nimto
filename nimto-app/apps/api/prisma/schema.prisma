generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DEACTIVATED
  PENDING_DELETION
}

enum OAuthProvider {
  GOOGLE
}

enum SessionRevocationReason {
  USER_LOGOUT
  ADMIN_FORCE_LOGOUT
  PASSWORD_CHANGED
  ACCOUNT_BLOCKED
  ACCOUNT_DEACTIVATED
  ACCOUNT_PENDING_DELETION
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum DesignCatalogStatus {
  ACTIVE
  INACTIVE
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum DesignStatus {
  ACTIVE
  UNPUBLISHED
}

enum DesignVersionStatus {
  CURRENT
  SUPERSEDED
}

enum AnimationComponentType {
  OPENING
  BACKGROUND
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  phone               String?
  passwordHash        String?
  status              UserStatus           @default(ACTIVE)
  emailVerifiedAt     DateTime?
  blockedAt           DateTime?
  deactivatedAt       DateTime?
  deletionRequestedAt DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  oauthAccounts       OAuthAccount[]
  roles               UserRole[]
  sessions            UserSession[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  events              Event[]
  blogPosts           BlogPost[]
  auditLogs           AuditLog[]
  designCategories    DesignCategory[]     @relation("DesignCategoriesCreated")
  designSubcategories DesignSubcategory[]  @relation("DesignSubcategoriesCreated")
  invitationTemplates InvitationTemplate[] @relation("InvitationTemplatesCreated")
  invitationDesigns   InvitationDesign[]   @relation("InvitationDesignsCreated")
  designVersions      DesignVersion[]      @relation("DesignVersionsPublished")
  animationComponents AnimationComponent[] @relation("AnimationComponentsCreated")
  designUsageHistory  UserDesignUsage[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@index([isSystem])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model DesignCategory {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  description   String?
  sortOrder     Int                  @default(0)
  status        DesignCatalogStatus  @default(ACTIVE)
  createdById   String?
  createdBy     User?                @relation("DesignCategoriesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  subcategories DesignSubcategory[]
  templates     InvitationTemplate[]
  designs       InvitationDesign[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, sortOrder])
  @@index([createdById])
}

model DesignSubcategory {
  id          String               @id @default(cuid())
  categoryId  String
  category    DesignCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  sortOrder   Int                  @default(0)
  status      DesignCatalogStatus  @default(ACTIVE)
  createdById String?
  createdBy   User?                @relation("DesignSubcategoriesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  templates   InvitationTemplate[]
  designs     InvitationDesign[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
  @@index([createdById])
}

model InvitationTemplate {
  id                   String                        @id @default(cuid())
  name                 String
  status               TemplateStatus                @default(DRAFT)
  rawHtml              String
  thumbnailHtml        String?
  sourceFileName       String?
  htmlSize             Int
  scanResult           Json?
  featureConfig        Json?
  scannedAt            DateTime?
  designId             String?
  design               InvitationDesign?             @relation(fields: [designId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             DesignCategory?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId        String?
  subcategory          DesignSubcategory?            @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdById          String?
  createdBy            User?                         @relation("InvitationTemplatesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  animationAssignments TemplateAnimationAssignment[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([createdById])
  @@index([designId])
  @@index([categoryId])
  @@index([subcategoryId])
}

model InvitationDesign {
  id               String               @id @default(cuid())
  templateId       String?
  name             String
  slug             String               @unique
  status           DesignStatus         @default(ACTIVE)
  categoryId       String?
  category         DesignCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId    String?
  subcategory      DesignSubcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?                @relation("InvitationDesignsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  templates        InvitationTemplate[]
  versions         DesignVersion[]
  userUsageHistory UserDesignUsage[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([createdById])
}

model DesignVersion {
  id               String                @id @default(cuid())
  designId         String
  design           InvitationDesign      @relation(fields: [designId], references: [id], onDelete: Cascade)
  templateId       String?
  versionNumber    Int
  status           DesignVersionStatus   @default(CURRENT)
  name             String
  rawHtml          String
  thumbnailHtml    String?
  htmlSize         Int
  scanResult       Json?
  featureConfig    Json?
  publishedById    String?
  publishedBy      User?                 @relation("DesignVersionsPublished", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedEvents  Event[]               @relation("PublishedEventDesign")
  draftEvents      Event[]               @relation("DraftEventDesign")
  eventRevisions   EventDesignRevision[]
  userUsageHistory UserDesignUsage[]
  createdAt        DateTime              @default(now())

  @@unique([designId, versionNumber])
  @@index([status, createdAt])
  @@index([templateId])
  @@index([publishedById])
}

model UserSession {
  id               String                   @id @default(cuid())
  userId           String
  tokenHash        String                   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason SessionRevocationReason?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PendingRegistration {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  verificationCode String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Event {
  id                     String                @id @default(cuid())
  userId                 String
  title                  String
  type                   EventType             @default(WEDDING)
  eventDate              DateTime?
  venue                  String?
  description            String?
  slug                   String                @unique
  coverImage             String?
  isPublished            Boolean               @default(false)
  archivedAt             DateTime?
  firstOpenedAt          DateTime?
  lastOpenedAt           DateTime?
  openCount              Int                   @default(0)
  rsvpDeadline           DateTime?
  organizerNotes         String?
  checklist              Json?
  designVersionId        String?
  designVersion          DesignVersion?        @relation("PublishedEventDesign", fields: [designVersionId], references: [id], onDelete: Restrict)
  designFieldValues      Json?
  featureSettings        Json?
  rsvpConfig             Json?
  draftDesignVersionId   String?
  draftDesignVersion     DesignVersion?        @relation("DraftEventDesign", fields: [draftDesignVersionId], references: [id], onDelete: Restrict)
  draftDesignFieldValues Json?
  draftSavedAt           DateTime?
  invitees               InvitationInvitee[]
  rsvpResponses          EventRsvpResponse[]
  designRevisions        EventDesignRevision[]
  activities             EventActivity[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([isPublished])
  @@index([archivedAt])
  @@index([designVersionId])
  @@index([draftDesignVersionId])
}

model EventRsvpResponse {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      RsvpStatus
  answers     Json
  guestCount  Int?
  submittedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([eventId])
  @@index([eventId, status])
  @@index([submittedAt])
}

model InvitationInvitee {
  id               String          @id @default(cuid())
  eventId          String
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  groupName        String?
  organizerNotes   String?
  slug             String          @unique
  linkDisabledAt   DateTime?
  linkExpiresAt    DateTime?
  lastSharedAt     DateTime?
  lastShareChannel String?
  firstOpenedAt    DateTime?
  lastOpenedAt     DateTime?
  openCount        Int             @default(0)
  rsvpStatus       RsvpStatus      @default(PENDING)
  partySize        Int?
  mealPreference   String?
  rsvpMessage      String?
  rsvpAnswers      Json?
  respondedAt      DateTime?
  activities       EventActivity[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
  @@index([eventId, rsvpStatus])
  @@index([slug])
  @@index([eventId, groupName])
}

model EventDesignRevision {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  designVersionId String
  designVersion   DesignVersion @relation(fields: [designVersionId], references: [id], onDelete: Restrict)
  fieldValues     Json
  label           String?
  createdAt       DateTime      @default(now())

  @@index([eventId, createdAt])
  @@index([designVersionId])
}

model EventActivity {
  id        String             @id @default(cuid())
  eventId   String
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String?
  invitee   InvitationInvitee? @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime           @default(now())

  @@index([eventId, createdAt])
  @@index([inviteeId])
  @@index([type])
}

model UserDesignUsage {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId          String
  design            InvitationDesign @relation(fields: [designId], references: [id], onDelete: Restrict)
  lastUsedVersionId String
  lastUsedVersion   DesignVersion    @relation(fields: [lastUsedVersionId], references: [id], onDelete: Restrict)
  usageCount        Int              @default(1)
  firstUsedAt       DateTime         @default(now())
  lastUsedAt        DateTime         @default(now())

  @@unique([userId, designId])
  @@index([userId, lastUsedAt])
  @@index([designId])
  @@index([lastUsedVersionId])
}

model AnimationComponent {
  id                  String                        @id @default(cuid())
  type                AnimationComponentType
  name                String
  slug                String                        @unique
  rawHtml             String
  sourceFileName      String?
  htmlSize            Int
  scanResult          Json?
  status              DesignCatalogStatus           @default(ACTIVE)
  createdById         String?
  createdBy           User?                         @relation("AnimationComponentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  templateAssignments TemplateAnimationAssignment[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([type, status])
  @@index([createdById])
}

model TemplateAnimationAssignment {
  id                   String             @id @default(cuid())
  templateId           String
  template             InvitationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  animationComponentId String
  animationComponent   AnimationComponent @relation(fields: [animationComponentId], references: [id], onDelete: Cascade)
  slotKey              String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([templateId, slotKey])
  @@index([animationComponentId])
}

model PageContent {
  id          String    @id @default(cuid())
  key         String    @unique
  title       String
  subtitle    String?
  body        String?
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
}

model BlogPost {
  id              String        @id @default(cuid())
  authorId        String
  title           String
  slug            String        @unique
  excerpt         String?
  citationSummary String?
  content         String
  metaTitle       String?
  metaDescription String?
  keywords        String?
  faq             Json?
  sources         Json?
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  author          User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([slug])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
