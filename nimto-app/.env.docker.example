# Local-only Docker settings. Copy this file to .env.docker.
POSTGRES_DB=nimto
POSTGRES_USER=nimto
POSTGRES_PASSWORD=nimto_local_password
POSTGRES_PORT=5432

WEB_PORT=3000
API_PORT=4000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
ADMINER_PORT=8080

JWT_SECRET=local-development-jwt-secret-change-me
SUPER_ADMIN_EMAIL=admin@nimto.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Nimto Local Admin

# Google OAuth is the one feature that still needs Google's online service.
# Leave these blank for fully local email/password development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
