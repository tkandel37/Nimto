{
  "name": "nimto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nimto/web",
    "dev:api": "npm run start:dev -w @nimto/api",
    "build:web": "npm run build -w @nimto/web",
    "build:api": "npm run build -w @nimto/api",
    "lint:web": "npm run lint -w @nimto/web",
    "prisma:generate": "npm run prisma:generate -w @nimto/api",
    "prisma:migrate": "npm run prisma:migrate -w @nimto/api"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
